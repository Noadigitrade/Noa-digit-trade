<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>NOA DIGIT TRADE — Administration</title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #17202a;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    .hidden {
      display: none !important;
    }

    .page {
      min-height: 100vh;
    }

    /* =====================================================
       LOGIN
       ===================================================== */

    #adminLoginPage {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-box {
      width: 100%;
      max-width: 430px;
      background: white;
      border-radius: 18px;
      padding: 28px;
      box-shadow: 0 10px 35px rgba(0,0,0,.08);
    }

    .logo {
      text-align: center;
      font-size: 26px;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .admin-title {
      text-align: center;
      font-size: 18px;
      margin-bottom: 25px;
      color: #555;
    }

    .field {
      margin-bottom: 16px;
    }

    .field label {
      display: block;
      margin-bottom: 7px;
      font-weight: 600;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      padding: 13px;
      border: 1px solid #d7dce1;
      border-radius: 10px;
      outline: none;
      background: white;
    }

    .field textarea {
      min-height: 100px;
      resize: vertical;
    }

    .btn {
      border: 0;
      border-radius: 10px;
      padding: 13px 17px;
      cursor: pointer;
      font-weight: 700;
    }

    .btn-primary {
      width: 100%;
      background: #111827;
      color: white;
    }

    .btn-success {
      background: #16803c;
      color: white;
    }

    .btn-warning {
      background: #d97706;
      color: white;
    }

    .btn-danger {
      background: #c62828;
      color: white;
    }

    .btn-secondary {
      background: #e5e7eb;
      color: #111827;
    }

    .message {
      margin-top: 15px;
      padding: 12px;
      border-radius: 10px;
      display: none;
      font-size: 14px;
    }

    .message.show {
      display: block;
    }

    .message.error {
      background: #fee2e2;
      color: #991b1b;
    }

    .message.success {
      background: #dcfce7;
      color: #166534;
    }

    /* =====================================================
       ADMIN
       ===================================================== */

    #adminPage {
      min-height: 100vh;
    }

    .topbar {
      background: #111827;
      color: white;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .topbar-title {
      font-weight: 800;
      font-size: 20px;
    }

    .topbar-user {
      font-size: 13px;
      opacity: .85;
    }

    .logout-btn {
      border: 1px solid rgba(255,255,255,.3);
      background: transparent;
      color: white;
      border-radius: 8px;
      padding: 8px 12px;
      cursor: pointer;
    }

    .container {
      max-width: 1250px;
      margin: auto;
      padding: 20px;
    }

    /* =====================================================
       STATS
       ===================================================== */

    .stats {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat-card {
      background: white;
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 3px 15px rgba(0,0,0,.05);
    }

    .stat-label {
      color: #6b7280;
      font-size: 13px;
      margin-bottom: 8px;
    }

    .stat-value {
      font-size: 25px;
      font-weight: 800;
    }

    /* =====================================================
       TABS
       ===================================================== */

    .tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      margin-bottom: 20px;
    }

    .tab {
      border: 0;
      background: white;
      padding: 11px 16px;
      border-radius: 10px;
      cursor: pointer;
      white-space: nowrap;
      font-weight: 700;
    }

    .tab.active {
      background: #111827;
      color: white;
    }

    .admin-section {
      display: none;
    }

    .admin-section.active {
      display: block;
    }

    /* =====================================================
       TOOLBAR
       ===================================================== */

    .toolbar {
      background: white;
      border-radius: 15px;
      padding: 15px;
      margin-bottom: 15px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .toolbar input,
    .toolbar select {
      padding: 11px;
      border: 1px solid #d7dce1;
      border-radius: 9px;
      min-width: 180px;
    }

    /* =====================================================
       TABLE
       ===================================================== */

    .table-wrapper {
      background: white;
      border-radius: 15px;
      overflow-x: auto;
      box-shadow: 0 3px 15px rgba(0,0,0,.05);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 850px;
    }

    th,
    td {
      padding: 13px;
      text-align: left;
      border-bottom: 1px solid #edf0f2;
      font-size: 14px;
    }

    th {
      background: #f8fafc;
      font-size: 12px;
      text-transform: uppercase;
      color: #667085;
    }

    .status {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      background: #e5e7eb;
    }

    .status.pending {
      background: #fef3c7;
      color: #92400e;
    }

    .status.payment_declared,
    .status.paid {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .status.processing {
      background: #ede9fe;
      color: #6d28d9;
    }

    .status.completed,
    .status.verified {
      background: #dcfce7;
      color: #166534;
    }

    .status.rejected,
    .status.cancelled,
    .status.failed {
      background: #fee2e2;
      color: #991b1b;
    }

    .action-btn {
      border: 0;
      padding: 7px 10px;
      border-radius: 7px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      background: #111827;
      color: white;
    }

    /* =====================================================
       MODAL
       ===================================================== */

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.55);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 15px;
      z-index: 50;
    }

    .modal.show {
      display: flex;
    }

    .modal-box {
      background: white;
      width: 100%;
      max-width: 650px;
      max-height: 90vh;
      overflow-y: auto;
      border-radius: 18px;
      padding: 22px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
    }

    .close-btn {
      border: 0;
      background: #eee;
      width: 35px;
      height: 35px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 20px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding: 10px 0;
      border-bottom: 1px solid #eee;
    }

    .detail-row span:first-child {
      color: #667085;
    }

    .detail-row strong {
      text-align: right;
      max-width: 65%;
      word-break: break-word;
    }

    .modal-actions {
      margin-top: 20px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 800px) {

      .stats {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .topbar {
        align-items: flex-start;
        flex-direction: column;
      }

    }

    @media (max-width: 480px) {

      .stats {
        grid-template-columns: 1fr;
      }

      .container {
        padding: 12px;
      }

    }

  </style>
</head>

<body>

  <!-- =====================================================
       LOGIN ADMIN
       ===================================================== -->

  <section id="adminLoginPage">

    <div class="login-box">

      <div class="logo">
        NOA DIGIT TRADE
      </div>

      <div class="admin-title">
        Espace Administration
      </div>

      <form id="adminLoginForm">

        <div class="field">

          <label for="adminEmail">
            Email administrateur
          </label>

          <input
            id="adminEmail"
            type="email"
            autocomplete="email"
            required
          >

        </div>

        <div class="field">

          <label for="adminPassword">
            Mot de passe
          </label>

          <input
            id="adminPassword"
            type="password"
            autocomplete="current-password"
            required
          >

        </div>

        <button
          id="adminLoginBtn"
          class="btn btn-primary"
          type="submit"
        >
          Se connecter
        </button>

      </form>

      <div
        id="loginMessage"
        class="message"
      ></div>

    </div>

  </section>


  <!-- =====================================================
       TABLEAU ADMIN
       ===================================================== -->

  <section
    id="adminPage"
    class="hidden"
  >

    <header class="topbar">

      <div>

        <div class="topbar-title">
          NOA DIGIT TRADE — ADMIN
        </div>

        <div
          id="adminUserName"
          class="topbar-user"
        >
          Administrateur
        </div>

      </div>

      <button
        id="adminLogoutBtn"
        class="logout-btn"
      >
        Déconnexion
      </button>

    </header>


    <main class="container">

      <!-- =================================================
           STATISTIQUES
           ================================================= -->

      <div class="stats">

        <div class="stat-card">

          <div class="stat-label">
            Total commandes
          </div>

          <div
            id="statTotalOrders"
            class="stat-value"
          >
            0
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            En attente
          </div>

          <div
            id="statPending"
            class="stat-value"
          >
            0
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Paiements déclarés
          </div>

          <div
            id="statPayments"
            class="stat-value"
          >
            0
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Terminées
          </div>

          <div
            id="statCompleted"
            class="stat-value"
          >
            0
          </div>

        </div>

      </div>


      <!-- =================================================
           ONGLETS
           ================================================= -->

      <div class="tabs">

        <button
          class="tab active"
          data-section="ordersSection"
        >
          📋 Commandes
        </button>

        <button
          class="tab"
          data-section="disputesSection"
        >
          ⚠️ Litiges
        </button>

        <button
          class="tab"
          data-section="usersSection"
        >
          👥 Utilisateurs
        </button>

      </div>


      <!-- =================================================
           COMMANDES
           ================================================= -->

      <section
        id="ordersSection"
        class="admin-section active"
      >

        <div class="toolbar">

          <input
            id="orderSearch"
            type="search"
            placeholder="Rechercher une commande..."
          >

          <select id="orderStatusFilter">

            <option value="">
              Tous les statuts
            </option>

            <option value="pending">
              En attente
            </option>

            <option value="payment_declared">
              Paiement déclaré
            </option>

            <option value="processing">
              En traitement
            </option>

            <option value="completed">
              Terminées
            </option>

            <option value="rejected">
              Rejetées
            </option>

            <option value="cancelled">
              Annulées
            </option>

          </select>

          <button
            id="refreshOrdersBtn"
            class="btn btn-secondary"
          >
            Actualiser
          </button>

        </div>


        <div class="table-wrapper">

          <table>

            <thead>

              <tr>

                <th>Commande</th>

                <th>Type</th>

                <th>Client</th>

                <th>Montant</th>

                <th>Réseau</th>

                <th>Statut</th>

                <th>Date</th>

                <th></th>

              </tr>

            </thead>

            <tbody id="ordersTableBody">

              <tr>

                <td
                  colspan="8"
                  style="text-align:center"
                >
                  Chargement...

                </td>

              </tr>

            </tbody>

          </table>

        </div>

      </section>


      <!-- =================================================
           LITIGES
           ================================================= -->

      <section
        id="disputesSection"
        class="admin-section"
      >

        <div class="toolbar">

          <button
            id="refreshDisputesBtn"
            class="btn btn-secondary"
          >
            Actualiser les litiges
          </button>

        </div>


        <div class="table-wrapper">

          <table>

            <thead>

              <tr>

                <th>Litige</th>

                <th>Commande</th>

                <th>Client</th>

                <th>Sujet</th>

                <th>Statut</th>

                <th>Date</th>

                <th></th>

              </tr>

            </thead>

            <tbody id="disputesTableBody">

              <tr>

                <td
                  colspan="7"
                  style="text-align:center"
                >
                  Chargement...

                </td>

              </tr>

            </tbody>

          </table>

        </div>

      </section>


      <!-- =================================================
           UTILISATEURS
           ================================================= -->

      <section
        id="usersSection"
        class="admin-section"
      >

        <div class="toolbar">

          <input
            id="userSearch"
            type="search"
            placeholder="Rechercher un utilisateur..."
          >

          <button
            id="refreshUsersBtn"
            class="btn btn-secondary"
          >
            Actualiser
          </button>

        </div>


        <div class="table-wrapper">

          <table>

            <thead>

              <tr>

                <th>Nom</th>

                <th>Téléphone</th>

                <th>Pays</th>

                <th>Rôle</th>

                <th>ID</th>

              </tr>

            </thead>

            <tbody id="usersTableBody">

              <tr>

                <td
                  colspan="5"
                  style="text-align:center"
                >
                  Chargement...

                </td>

              </tr>

            </tbody>

          </table>

        </div>

      </section>

    </main>

  </section>


  <!-- =====================================================
       MODAL COMMANDE
       ===================================================== -->

  <div
    id="orderModal"
    class="modal"
  >

    <div class="modal-box">

      <div class="modal-header">

        <h2>
          Détails de la commande
        </h2>

        <button
          id="closeOrderModalBtn"
          class="close-btn"
        >
          ×
        </button>

      </div>

      <div id="orderDetails"></div>

      <div class="modal-actions">

        <button
          class="btn btn-success"
          data-order-status="verified"
        >
          Paiement vérifié
        </button>

        <button
          class="btn btn-warning"
          data-order-status="processing"
        >
          En traitement
        </button>

        <button
          class="btn btn-success"
          data-order-status="completed"
        >
          Terminée
        </button>

        <button
          class="btn btn-danger"
          data-order-status="rejected"
        >
          Rejeter
        </button>

      </div>

      <div
        id="orderModalMessage"
        class="message"
      ></div>

    </div>

  </div>


  <!-- =====================================================
       MODAL LITIGE
       ===================================================== -->

  <div
    id="disputeModal"
    class="modal"
  >

    <div class="modal-box">

      <div class="modal-header">

        <h2>
          Détails du litige
        </h2>

        <button
          id="closeDisputeModalBtn"
          class="close-btn"
        >
          ×
        </button>

      </div>

      <div id="disputeDetails"></div>

      <div class="modal-actions">

        <button
          class="btn btn-warning"
          data-dispute-status="processing"
        >
          Prendre en charge
        </button>

        <button
          class="btn btn-success"
          data-dispute-status="resolved"
        >
          Résolu
        </button>

        <button
          class="btn btn-secondary"
          data-dispute-status="closed"
        >
          Fermer
        </button>

      </div>

      <div
        id="disputeModalMessage"
        class="message"
      ></div>

    </div>

  </div>


  <!-- =====================================================
       SUPABASE
       ===================================================== -->

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script src="admin.js"></script>

</body>
</html>
